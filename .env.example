# AEGIS IV — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file.

# Pipedream webhook (primary dispatch channel)
PIPEDREAM_WEBHOOK_URL=https://your-webhook-id.m.pipedream.net

# Telegram Bot API (fallback dispatch channel)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional: separate Pipedream webhook for audio alerts
PIPEDREAM_AUDIO_ALERT_WEBHOOK_URL=https://your-audio-alert-webhook-id.m.pipedream.net/audio_alert
